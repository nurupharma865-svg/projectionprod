rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ProjeTexte fonctionne sans comptes : les données sont publiques.
    // Toute personne connaissant l'application peut lire et modifier la bibliothèque.
    match /projects/{projectId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll([
        'title', 'sourceType', 'pageCount', 'contentPath', 'createdAt', 'updatedAt'
      ])
      && request.resource.data.title is string
      && request.resource.data.title.size() > 0
      && request.resource.data.title.size() <= 300
      && request.resource.data.pageCount is int
      && request.resource.data.pageCount >= 0
      && request.resource.data.contentPath == 'projects/' + projectId + '/content.json';
      allow update: if request.resource.data.keys().hasAll([
        'title', 'sourceType', 'pageCount', 'contentPath', 'createdAt', 'updatedAt'
      ])
      && request.resource.data.title is string
      && request.resource.data.title.size() > 0
      && request.resource.data.title.size() <= 300
      && request.resource.data.pageCount is int
      && request.resource.data.pageCount >= 0
      && request.resource.data.contentPath == 'projects/' + projectId + '/content.json';
      allow delete: if true;

      match /points/{pointId} {
        allow read, create, update, delete: if true;
      }
    }
  }
}
